# Copy this file to .env and fill in real values.
# cp .env.example .env

# Port the resource server listens on
PORT=4021

# SELLER account: the Hedera testnet account id that RECEIVES payments.
# No private key needed for this one — it's just a receiving address.
PAY_TO_ACCOUNT=0.0.YOUR_RECEIVING_ACCOUNT

# Facilitator that verifies + settles Hedera payments on your behalf.
# Blocky402's testnet endpoint is open access, no API key required.
FACILITATOR_URL=https://api.testnet.blocky402.com

# x402 network identifier for Hedera testnet
HEDERA_NETWORK=hedera:testnet

# --- Only needed if you use scripts/buy.ts (the standalone CLI tester) ---
# BUYER account: a funded testnet account that PAYS for each request.
# Get testnet HBAR at https://portal.hedera.com (funds it automatically).
# For the USDC-priced product, also get testnet USDC at
# https://faucet.circle.com (select Hedera Testnet) and run:
#   npm run associate
# once, to associate this account with the USDC token before paying with it.
HEDERA_ACCOUNT_ID=0.0.YOUR_BUYER_ACCOUNT
HEDERA_PRIVATE_KEY=YOUR_BUYER_ECDSA_PRIVATE_KEY

RESOURCE_SERVER_URL=http://localhost:4021
