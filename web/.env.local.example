# Copy this file to .env.local and fill in real values.
# cp .env.local.example .env.local
#
# Everything here is read ONLY inside app/api/pay/route.ts, which runs on
# the server (Node.js runtime). It is never bundled into client-side JS,
# so the private key never reaches the browser.

# BUYER account: a funded Hedera testnet account that PAYS for each request.
# Get one free at https://portal.hedera.com
HEDERA_ACCOUNT_ID=0.0.YOUR_BUYER_ACCOUNT
HEDERA_PRIVATE_KEY=YOUR_BUYER_ECDSA_PRIVATE_KEY
PAY_TO_ACCOUNT=0.0.9693209
FACILITATOR_URL=https://api.testnet.blocky402.com
HEDERA_NETWORK=hedera:testnet

# --- Autonomous agent (app/api/agent/run) --------------------------------
# Only needed if you want to test the agent route locally. On Vercel, set
# this in Project Settings -> Environment Variables; Vercel's Cron caller
# will automatically send it as the Authorization header on schedule.
CRON_SECRET=any-random-string-you-choose