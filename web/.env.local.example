# Copy this file to .env.local and fill in real values.
# cp .env.local.example .env.local
#
# Everything here is read ONLY inside app/api/pay/route.ts, which runs on
# the server (Node.js runtime). It is never bundled into client-side JS,
# so the private key never reaches the browser.

# BUYER account: a funded Hedera testnet account that PAYS for each request.
# Get one free at https://portal.hedera.com
HEDERA_ACCOUNT_ID=0.0.YOUR_BUYER_ACCOUNT
HEDERA_PRIVATE_KEY=YOUR_BUYER_ECDSA_PRIVATE_KEY

HEDERA_NETWORK=hedera:testnet

# Where the resource server (the ../server app) is running
RESOURCE_SERVER_URL=http://localhost:4021
